# ═══════════════════════════════════════════════
# UnionAgents 本地敏感配置
# 复制此文件为 .env.local 后填入实际值
# 已加入 .gitignore，不会提交到仓库
# ═══════════════════════════════════════════════

# --- 容器镜像仓库（REGISTRY 仅填主机名，命名空间 unionagents 由部署清单自动拼接；凭据为拉取/推送账号）---
# 示例：registry.example.com （云上填真实仓库主机名）
REGISTRY="registry.example.com"
REGISTRY_USERNAME="your-registry-username"
REGISTRY_PASSWORD="your-registry-password"

# --- PostgreSQL 数据库 ---
DB_USER="your-db-user"
DB_PASSWORD="your-db-password"
DB_HOST="your-db-host"
DB_NAME="unionagents"
# HUB_DATABASE_URL 由 deploy.sh 从上面的 DB_* 自动派生（psycopg 同步驱动，hub 共用 unionagents 库）
# LITELLM_DATABASE_URL 同理由 deploy.sh 派生（指向独立 litellm 库）

# --- JWT 签名密钥 ---
# 生产环境（UA_ENVIRONMENT=prod）必须设为非默认值，否则 manager/gateway 启动 fail-fast
JWT_SECRET="your-jwt-secret-min-32-chars"

# --- 运行环境 ---
# dev: 保留默认 JWT 密钥、CORS 走无凭证通配（本地零配置）
# prod: 强制显式 JWT_SECRET；部署清单已为 manager/gateway 注入 prod + CORS 白名单
UA_ENVIRONMENT="prod"

# --- Skill 凭证加密 key（Fernet 派生；prod 必填）---
# manager 启动 fail-fast 校验非空。设后不可改（已存凭证将无法解密），必须冷备。
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
CREDENTIAL_ENCRYPTION_KEY="change-me-credential-encryption-key"

# --- 智能体 API Key HMAC 签名密钥（OpenAI 兼容 sk- Key；prod 必填）---
# manager/gateway 启动 fail-fast 校验 ≥ 32 字符。设后不可改（改后所有已签发 Key 失效）。
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY_HMAC_SECRET="change-me-api-key-hmac-secret-min-32-chars"

# --- 对象存储（S3 兼容：云上托管 OSS/COS 等，或本地 MinIO）---
OSS_ACCESS_KEY="your-oss-access-key-id"
OSS_SECRET_KEY="your-oss-secret-key"

# --- 引擎通信密钥 ---
API_SERVER_KEY="your-api-server-key"

# --- gateway↔manager 内部服务令牌（#4 修复：sk- API Key 客户端图片解析用）---
# gateway 调 manager /files/content 时带 X-Internal-Token 头，替代转发 client token
# （后者对 sk- 客户端会被 manager 当 JWT 拒收 401）。gateway 与 manager 必须一致。
# dev 留空则不带该头（sk- 图片解析不可用，JWT 客户端不受影响）；prod 必填。
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
UA_INTERNAL_TOKEN="change-me-internal-token"

# --- 语音 ASR（豆包 OpenSpeech X-Api-Key）---
# 火山引擎方舟控制台创建 API Key，填这里。gateway 通过 secretKeyRef 引用。
# 不填则语音识别不可用（其他功能不受影响）。
ASR_VOLC_API_KEY="your-volcengine-asr-api-key"

# --- LiteLLM 模型网关 ---
# master key：manager 管理 LiteLLM 的 Bearer 凭据（sk- 开头，建议随机 32+ 字符）
LITELLM_MASTER_KEY="sk-ua-litellm-master-change-me"
# salt key：LiteLLM 加密上游供应商凭据，设后不可改，必须冷备
LITELLM_SALT_KEY="sk-ua-litellm-salt-change-me"

# --- Ingress 控制器类型（nginx / traefik）---
# k3s 默认用 traefik，标准 K8s 用 nginx
INGRESS_CLASS="nginx"

# --- 引擎数据 PVC 的 StorageClass ---
# 单节点 k3s / 开发环境用 local-path；云厂商托管 K8s 用对应磁盘型 StorageClass（需装 CSI）
PVC_STORAGE_CLASS="local-path"

# --- 部署域名（如 example.com）---
DOMAIN="your-domain.com"

# --- TLS 证书（admin/chat/landing 共用 unionagentservice-tls secret）---
# 证书文件路径（.crt / .pem），不配则 HTTPS 使用自签证书
# 示例：acme.sh 申请的证书路径如 ~/.acme.sh/your-domain.com/your-domain.com.cer
TLS_CERT_PATH=""
TLS_KEY_PATH=""

# --- KubeConfig 路径（指定后部署到该集群，否则用默认 context）---
KUBECONFIG_PATH="$HOME/.kube/config.unionagents"

# --- 对象存储 endpoint（云上用 S3 兼容 endpoint 如 OSS/COS，本地用 http://minio:9000）---
UA_MINIO_ENDPOINT="http://minio:9000"
# --- 对象存储 region（部分 S3 兼容服务需要，如 us-east-1 / cn-hangzhou；MinIO 留空）---
UA_MINIO_REGION=""
# --- Grafana 外部可访问地址（监控页"在 Grafana 中查看"链接，如 http://<公网IP>:30090）---
GRAFANA_EXTERNAL_URL=""

# --- APK 发布 keystore（APP 管理：base APK patch 后用此 keystore 重签）---
# keystore 文件路径（dev 本地，相对仓库根）
# 生成：keytool -genkeypair -v -keystore release.keystore -alias unionagents -keyalg RSA -keysize 2048 -validity 10000
RELEASE_KEYSTORE_PATH="apps/android/release.keystore"
# keystore base64 编码（deploy.sh 会读此路径转 base64 写入 secret）
# 由 deploy.sh 自动派生：RELEASE_KEYSTORE_BASE64=$(base64 -i $RELEASE_KEYSTORE_PATH | tr -d '\n')
KEYSTORE_ALIAS="unionagents"
KEYSTORE_PASSWORD="your-keystore-password"
KEY_PASSWORD="your-key-password"
