# ── PostgreSQL (business ontology metadata) ──
PG_HOST=localhost
PG_PORT=5432
PG_USER=ontology
PG_PASSWORD=ontology
PG_DATABASE=ontology

# ── Gravitino (physical asset catalog) ──
GRAVITINO_HOST=localhost
GRAVITINO_PORT=8090
# Host override for JDBC URLs stored on Gravitino/Trino catalogs. The backend
# reads a datasource's host from its own view (localhost on the host), but the
# catalog is consumed inside the Gravitino/Trino container where localhost is
# the container itself. Set to the source DB's container name (e.g.
# "benchmark-mysql") when Gravitino and the source DB share a docker network.
# Empty = use the datasource's own host (only when backend & Gravitino share
# the host view).
CATALOG_JDBC_HOST_OVERRIDE=

# ── Iceberg REST Catalog (served by Gravitino) ──
ICEBERG_REST_URI=http://localhost:9001/iceberg
ICEBERG_WAREHOUSE=s3://ontology-warehouse/
# Iceberg namespace under which all synced tables live (dataset api_names
# are stored without this prefix; IcebergStore prepends it).
ICEBERG_NAMESPACE=ontology

# ── RustFS / S3 ──
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PATH_STYLE_ACCESS=true
S3_REGION=us-east-1

# ── Doris (index acceleration) ──
DORIS_HOST=localhost
DORIS_PORT=9030
# Doris FE HTTP port — SeaTunnel Doris sink `fenodes` expects FE HTTP (stream load), not the MySQL port.
DORIS_FE_HTTP_PORT=8030
DORIS_USER=root
DORIS_PASSWORD=

# ── Trino (federated query engine) ──
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=ontology-api
TRINO_CATALOG=gravitino
TRINO_SCHEMA=ontology

# ── SeaTunnel (data pipeline) ──
SEATUNNEL_HOST=localhost
SEATUNNEL_REST_PORT=5801
# Host override for JDBC sources rendered into SeaTunnel sync pipelines.
# Same rationale as CATALOG_JDBC_HOST_OVERRIDE but for SeaTunnel's container
# view. Often the same value, but kept separate since SeaTunnel and Gravitino
# may run in different containers/networks.
SEATUNNEL_SOURCE_HOST_OVERRIDE=
# SeaTunnel-facing hosts: CDC templates (PG→Kafka→Doris) execute inside the
# SeaTunnel container, so they must use compose service names, NOT localhost
# (the SeaTunnel container's localhost points to itself). These mirror the
# API-host-facing PG/KAFKA/DORIS vars above but for the SeaTunnel container's
# network view. SEATUNNEL_PG_HOST / SEATUNNEL_DORIS_HOST already exist above
# (used by the INDEX sync pipelines); SEATUNNEL_KAFKA_BOOTSTRAP_SERVERS is new
# (P0 CDC link, 2026-07-06). Defaults match docker-compose.yml service names.
SEATUNNEL_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Kafka (real-time index sync) ──
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Application ──
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ── AI / LLM ──
# Model identifier in pydantic-ai format: provider:model_name
# Supported prefixes: openai, deepseek, anthropic, google, mistral, moonshotai,
#   alibaba, groq, grok/xai, openrouter, fireworks, together, cerebras, bedrock,
#   cohere, huggingface, ollama, etc.
# API key auto-discovered from corresponding env var (e.g. DEEPSEEK_API_KEY).
AI_MODEL=openai:gpt-4o
# Custom OpenAI-compatible endpoint base URL (GLM/Pangu/ZhipuAI/vLLM/LiteLLM
# gateways). Only effective when AI_MODEL uses openai:/openai-chat: prefix.
# Empty = OpenAI default https://api.openai.com/v1.
# GLM example: AI_MODEL=openai-chat:glm-4-plus, AI_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_OPENAI_BASE_URL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=16384
AI_RETRIES=2

# ── Kestra (Pipeline Builder, ADR-018) ──
KESTRA_HOST=localhost
KESTRA_PORT=8080
KESTRA_PASSWORD=
KESTRA_NAMESPACE_PREFIX=gaia

# ── Permission governance (ADR-016/017) ──
# Dev-mode principal resolution: when true (and BETTER_AUTH_URL is empty),
# the AuthMiddleware resolves the Principal from X-User-Id / X-User-Roles /
# X-User-Attributes request headers (design §3.1 dev fallback). Flip off
# once Better Auth is deployed (Phase 5) and JWT verification is wired.
AUTHZ_DEV_MODE=true
# Better Auth Server URL (Phase 5). Empty = dev mode (header fallback).
# When set, PrincipalService verifies Better Auth-issued JWTs via JWKS
# (Better Auth's jwt() plugin signs with EdDSA/Ed25519 and exposes the
# public key at {url}/api/auth/jwks).
BETTER_AUTH_URL=
# Better Auth JWT issuer / audience for verification (Phase 5). When empty,
# they default to BETTER_AUTH_URL (Better Auth uses baseURL for both).
BETTER_AUTH_JWT_ISSUER=
BETTER_AUTH_JWT_AUDIENCE=
# JIT auto-provisioning (design §2.3). When a user registers via Better Auth,
# the databaseHooks.user.create.after hook calls POST /identity/users with
# this token to auto-create a Gaia user record (subject = Better Auth uid).
# Set the same value in Better Auth's GAIA_PROVISION_TOKEN env. Empty = disabled.
GAIA_PROVISION_TOKEN=
# Gaia API URL for Better Auth's JIT hook to call (default: localhost:8000).
GAIA_API_URL=http://localhost:8000
# cashews permission cache URL (ADR-017 D2). mem:// for single-process dev,
# redis://host:6379/0 for distributed production. Same code, only URL changes.
PERMISSION_CACHE_URL=mem://
PERMISSION_CACHE_CLIENT_SIDE=false
# Better Auth shared secret (session-cookie signing + JWKS private-key
# encryption for the better-auth service). Gaia verifies JWTs via JWKS,
# NOT this secret. Set when deploying the Better Auth Server (docker-compose
# `better-auth` service); empty = dev mode (X-User-Id header fallback).
# Generate with `openssl rand -base64 32`. MUST be fixed across restarts —
# if it changes, all previously-encrypted JWKS private keys become
# undecryptable and every outstanding JWT fails verification.
# Put the real value in .env.local (gitignored), not here.
BETTER_AUTH_SECRET=
# Better Auth JWT key rotation (ADR-017 D3). Configured in auth.ts: 90-day
# rotationInterval + 30-day gracePeriod. No env var needed — rotation is
# automatic. To force a rotation for testing, delete the `jwks` table rows
# and restart the container (it generates a fresh keypair on first start).
