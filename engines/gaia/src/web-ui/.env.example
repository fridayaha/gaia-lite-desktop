# Gaia Web UI — environment variables (Vite, exposed to the browser via import.meta.env).
# Copy to .env.local (gitignored) and adjust. Never put secrets here — these are
# baked into the client bundle at build time.

# ── Edition（发行版开关，B6）──
# 控制前端构建产物：lite 砍图探索路由（GraphExplorePage + maplibre/cytoscape 扩展
# tree-shake 掉），保留本体建模画布。full 版全量。
# 实际注入靠 vite.config.ts 的 define __EDITION__（读 process.env.EDITION），
# 此变量仅供文档/统一管理。本地 dev：EDITION=lite pnpm dev；构建：EDITION=lite
# pnpm build。Dockerfile 通过 ARG EDITION 传入。
EDITION=full

# ── Better Auth integration (ADR-016/017 Phase 5) ──
# Enable the frontend auth flow (login page + JWT injection).
#   unset / false → dev fallback: no login page, backend resolves principals
#                   from X-User-Id headers (AUTHZ_DEV_MODE=true on the backend).
#   true          → full Better Auth flow: login page shown, JWT fetched and
#                   attached to every Gaia API call.
VITE_AUTH_ENABLED=false

# Better Auth Server URL. Empty (default) → same-origin, via the Vite dev proxy
# at /api/auth/* (for local dev with the better-auth container). Set to a full
# URL (e.g. https://auth.example.com) in production — the client calls it
# directly (requires Better Auth CORS + SameSite=None;Secure cookies).
VITE_BETTER_AUTH_URL=
