{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gaia",
  "version": "0.1.0",
  "identifier": "com.unionagents.gaia-lite",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "bash ../scripts/build-lite-frontend.sh",
    "beforeDevCommand": "bash ../scripts/build-lite-frontend.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Gaia",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../sidecar/gaia-lite-backend": "gaia-lite-backend",
      "../dist": "dist"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
