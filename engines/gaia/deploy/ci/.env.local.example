# ═══════════════════════════════════════════════
# Gaia 引擎部署配置
# 复制此文件为 .env.local 后填入实际值
# 已加入 .gitignore，不会提交到仓库
# ═══════════════════════════════════════════════

# --- 集群参数（preflight 会自动探测，不符会警告；可手动覆盖）---
# Pod 网段（Doris priority_networks 用；k3s 默认 10.42.0.0/16，部分集群是 /24）
# 探测实际值: kubectl get nodes -o jsonpath='{.items[0].spec.podCIDR}'
POD_CIDR="10.42.0.0/16"
# StorageClass（k3s 自带 local-path；标准 k8s 用集群已有 SC，如 standard / gp2 等）
STORAGE_CLASS="local-path"
# web-ui NodePort（避开 UA 的 30080/30081/30090/30030）
NODE_PORT_WEB_UI="30082"
# 官方镜像拉取策略（在线: IfNotPresent；离线: Never 需先导入官方镜像）
IMAGE_PULL_POLICY_INFRA="IfNotPresent"
# 自有镜像拉取策略（已 ctr import 到本地，必须 Never；除非从仓库拉则改 Always + 带 registry 前缀）
IMAGE_PULL_POLICY_SERVICES="Never"
# K8s 运行时（k3s 用 k3s ctr；标准 k8s 用 ctr -n k8s.io）
K8S_RUNTIME="k3s"
# 部署 profile：minimal（虚拟表/联邦查询，只起 PG+Gravitino+Trino+API+web-ui，约 2GB 内存）
#           full（全量，含 Doris/RustFS/SeaTunnel/Kafka/Kestra/Neo4j，约 8GB 内存）
DEPLOY_PROFILE="minimal"

# --- 多节点镜像分发（集群部署必填）---
# 自有镜像通过 ctr import 加载到节点 containerd，多节点集群需分发到所有将运行 Pod 的节点。
# 逗号分隔的 SSH 可达节点列表（user@host[:port]），留空=只导入本机（单节点集群）。
# 示例：2 节点集群（master + worker）
#   LOAD_IMAGES_NODES="root@192.168.0.125,root@192.168.0.172"
# load-images.sh 会通过 SSH 流式传输镜像到这些节点并自动补短名称 tag + 打节点标签。
# 未配置时仅本机导入，Pod 可能因 ErrImageNeverPull 调度失败（需手动补节点或用 nodeSelector）。
LOAD_IMAGES_NODES=""
# SSH 私钥路径（默认 ~/.ssh/id_rsa；若用其他密钥在此指定）
SSH_PRIVATE_KEY="$HOME/.ssh/id_rsa"
# SSH 默认端口（被 LOAD_IMAGES_NODES 中的 :port 覆盖）
SSH_PORT="22"

# --- Gaia PostgreSQL（独立实例，与平台 PG 隔离）---
GAIA_PG_USER="ontology"
GAIA_PG_PASSWORD="change-me-strong-password"
GAIA_PG_DATABASE="ontology"

# --- 对象存储 RustFS（独立实例，与平台 MinIO 隔离）---
GAIA_S3_ACCESS_KEY="minioadmin"
GAIA_S3_SECRET_KEY="change-me-strong-secret"

# --- Doris ---
GAIA_DORIS_USER="root"
GAIA_DORIS_PASSWORD=""

# --- Neo4j（可选，图推理功能）---
GAIA_NEO4J_PASSWORD="change-me"

# --- Better Auth ---
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
GAIA_BETTER_AUTH_SECRET="change-me-better-auth-secret-min-32-chars"
# JIT 自动建 Gaia 用户用的 provision token，空=禁用 JIT
GAIA_PROVISION_TOKEN=""
# Better Auth 信任的 Origin（CORS 白名单，逗号分隔）
# 必须包含用户实际访问系统的地址，否则登录请求会被 CORS 拒绝（403）
# 生产环境对外服务：填公网 NodePort 地址 http://<节点公网IP>:<NODE_PORT_WEB_UI>
# 如配了域名/ ingress，加上 https://your-domain
# dev 调试可额外加 localhost:5173/5174（vite dev server）
GAIA_TRUSTED_ORIGINS="http://190.92.221.172:30082"

# --- AI 模型配置 ---
# AI_MODEL 用 pydantic-ai 格式 provider:model_name。换模型只改这两项 + 对应 key。
# 默认 openai:gpt-4o（需配 GAIA_OPENAI_API_KEY）。常用选项：
#   - DeepSeek:   deepseek:deepseek-chat        → 配 GAIA_DEEPSEEK_API_KEY
#   - Kimi:       moonshotai:moonshot-v1-32k    → 配 GAIA_MOONSHOT_API_KEY
#   - 通义 Qwen:   alibaba:qwen-plus             → 配 GAIA_ALIBABA_API_KEY
#   - OpenAI:     openai:gpt-4o                 → 配 GAIA_OPENAI_API_KEY
GAIA_AI_MODEL="openai:gpt-4o"

# 自定义 OpenAI 兼容端点 base URL（GLM/Pangu/ZhipuAI/vLLM/LiteLLM 网关等）。
# 仅当 GAIA_AI_MODEL 用 openai:/openai-chat: 前缀时生效；内置 provider 忽略。
# 国产兼容端点大多只支持 Chat Completions API，必须用 openai-chat: 前缀（非 openai:）。
# 范例：
#   GLM 智谱:  GAIA_AI_MODEL="openai-chat:glm-4-plus"
#              GAIA_OPENAI_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
#              GAIA_OPENAI_API_KEY="<智谱 API Key>"
#   Pangu 盘古(华为云 OpenAI 兼容网关):
#              GAIA_AI_MODEL="openai-chat:pangu-xxx"
#              GAIA_OPENAI_BASE_URL="https://<pangu-gateway>/v1"
#              GAIA_OPENAI_API_KEY="<盘古 API Key>"
# 留空 = 用 OpenAI 默认 https://api.openai.com/v1
GAIA_OPENAI_BASE_URL=""

# --- AI Provider Keys（按 AI_MODEL 前缀生效，至少配一个）---
GAIA_OPENAI_API_KEY=""
GAIA_DEEPSEEK_API_KEY=""
GAIA_ANTHROPIC_API_KEY=""
GAIA_GOOGLE_API_KEY=""
GAIA_MOONSHOT_API_KEY=""
GAIA_ALIBABA_API_KEY=""

# --- KubeConfig 路径（指定后部署到该集群，否则用默认 context）---
KUBECONFIG_PATH="$HOME/.kube/config"
