# ============================================================
# Hermes Agent 云服务器部署 - 环境变量配置模板
# 使用方法: 复制为 .env 并填写必要配置
# ============================================================

# ==================== 镜像配置 ====================
# Hermes Agent Docker 镜像 (可指定版本)
HERMES_IMAGE=nousresearch/hermes-agent:latest

# ==================== 容器用户映射 ====================
# 容器内运行用户 UID/GID (避免 root 运行)
HERMES_UID=1000
HERMES_GID=1000

# ==================== LLM 提供商配置 ====================

# 默认 LLM 提供商 (openai / anthropic / deepseek / openrouter / custom)
HERMES_PROVIDER=openai

# 默认模型名称 (需与提供商匹配)
#   openai: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
#   anthropic: claude-sonnet-4-20250514, claude-haiku-4-20250506
#   deepseek: deepseek-chat, deepseek-reasoner
#   openrouter: openai/gpt-4o, anthropic/claude-sonnet
#   custom: 自定义模型名称
HERMES_MODEL=gpt-4o

# ==================== LLM 提供商 API Key ====================
# 至少配置一个 LLM 提供商的 API Key

# OpenAI (GPT-4, GPT-3.5)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# DeepSeek (DeepSeek-V3, R1)
DEEPSEEK_API_KEY=your-deepseek-api-key

# OpenRouter (200+ 模型聚合)
OPENROUTER_API_KEY=your-openrouter-api-key

# ==================== 自定义 LLM 端点 (可选) ====================
# 适用于自建 LLM 服务、代理转发、Azure OpenAI 等场景
# 示例:
#   自建 vLLM:    http://your-server:8000/v1
#   Azure OpenAI: https://your-resource.openai.azure.com/
#   API 代理:     https://api-proxy.example.com/v1
HERMES_BASE_URL=

# 自定义端点的 API Key (如与上述 Key 不同)
HERMES_CUSTOM_API_KEY=

# 自定义端点的 API 模式 (chat_completions / anthropic_messages / codex_responses)
HERMES_API_MODE=chat_completions

# ==================== 技能预装 (可选) ====================
# 启动时自动安装的技能列表 (逗号分隔)
# 示例: HERMES_PRELOAD_SKILLS=web-search,code-review,summarize
HERMES_PRELOAD_SKILLS=

# ==================== 端口配置 ====================
# Gateway HTTP 端口 (默认 8642)
GATEWAY_PORT=8642

# Dashboard Web UI 端口 (默认 9119, 通过 HERMES_DASHBOARD=1 在同容器内运行)
DASHBOARD_PORT=9119

# ==================== 备份配置 ====================
# 备份文件保留天数 (默认 7 天)
BACKUP_RETENTION_DAYS=7

# 备份文件存储路径 (默认 ./backups)
BACKUP_DIR=./backups

# ==================== 日志配置 ====================
# 日志级别 (debug, info, warn, error)
# HERMES_LOG_LEVEL=info

# 日志格式 (json, text)
HERMES_LOG_FORMAT=json
