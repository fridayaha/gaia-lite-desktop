apiVersion: v1
kind: Service
metadata:
  name: hermes-gateway-{{INSTANCE_ID}}-svc
  namespace: hermes
  labels:
    app: hermes-gateway
    instance: {{INSTANCE_ID}}
spec:
  type: NodePort
  selector:
    app: hermes-gateway
    instance: {{INSTANCE_ID}}
  ports:
  - name: gateway
    port: 8642
    targetPort: 8642
    nodePort: {{GATEWAY_NODE_PORT}}
    protocol: TCP
  - name: dashboard
    port: 9119
    targetPort: 9119
    nodePort: {{DASHBOARD_NODE_PORT}}
    protocol: TCP
