apiVersion: v1
kind: Secret
metadata:
  name: {{SECRET_NAME}}
  namespace: hermes
  labels:
    app: hermes-gateway
    instance: {{INSTANCE_ID}}
type: Opaque
stringData:
  # API Server authentication key (required for startup)
  API_SERVER_KEY: "{{API_SERVER_KEY}}"
  # LLM provider API key
  {{API_KEY_VAR_NAME}}: "{{API_KEY_VALUE}}"
