apiVersion: v1
kind: ConfigMap
metadata:
  name: {{CONFIGMAP_ENV_NAME}}
  namespace: hermes
  labels:
    app: hermes-gateway
    instance: {{INSTANCE_ID}}
data:
  HERMES_PROVIDER: "{{PROVIDER}}"
  HERMES_MODEL: "{{MODEL}}"
  HERMES_BASE_URL: "{{BASE_URL}}"
  HERMES_API_MODE: "{{API_MODE}}"
  HERMES_LOG_FORMAT: "json"
  HERMES_PRELOAD_SKILLS: "{{PRELOAD_SKILLS}}"
  # API Server must bind to 0.0.0.0 for NodePort and probes
  API_SERVER_HOST: "0.0.0.0"
