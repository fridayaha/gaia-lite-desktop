/**
 * Material Icon 渲染组件。
 * 内部是 ArkUI Path + 24x24 viewBox + scale 缩放到 iconSize。
 * 注意 1：prop 名不能用 size（与内置 CommonAttribute.size 冲突）。
 * 注意 2：Path commands() 坐标单位是 px 而非 vp，高密度屏上需乘密度（vp2px）。
 * 注意 3：px 路径绘制锚定在左上角，scale 必须绕 (0,0) 缩放，否则绕中心缩放会把绘制推出容器。
 */
@Component
export struct MIcon {
  @Prop path: string = ''
  @Prop iconSize: number = 24
  @Prop color: number = 0xFF1F2937

  build(): void {
    Stack() {
      Path()
        .commands(this.path)
        .fill(this.color)
        .strokeWidth(0)
        .width(this.iconSize)
        .height(this.iconSize)
        .scale({
          x: vp2px(this.iconSize) / 24,
          y: vp2px(this.iconSize) / 24,
          centerX: 0,
          centerY: 0,
        })
    }
    .width(this.iconSize)
    .height(this.iconSize)
    .alignContent(Alignment.Center)
  }
}
