FROM docker.m.daocloud.io/library/nginx:stable-alpine

ARG VERSION=unknown
COPY apps/admin/dist/ /usr/share/nginx/html/
COPY apps/docs/.vitepress/dist/ /usr/share/nginx/html/docs/
COPY apps/admin/nginx.conf /etc/nginx/conf.d/default.conf
# 本地构建时 .dockerignore 排除了 dist 下的 version.json，这里显式生成
# version-rocket 每 5min 轮询 /version.json 检测新版本，缺文件会 SPA fallback
# 到 index.html，res.json() 解析 <!doctype> 报 SyntaxError
RUN echo "{\"version\":\"$VERSION\"}" > /usr/share/nginx/html/version.json
# vite-plugin-compression 输出的 .gz 文件权限是 640、目录 750，nginx 用户读不了 → 显式放宽
RUN chmod -R a+rX /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
