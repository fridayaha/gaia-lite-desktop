# Release keystore config — copy to keystore.properties and fill in real values
# DO NOT commit the real keystore.properties or *.keystore/*.jks files
#
# Generate a release keystore:
#   keytool -genkeypair -v -keystore release.keystore -alias unionagents \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then fill in the paths and passwords:
keyAlias=unionagents
keyPassword=change-me
storeFile=release.keystore
storePassword=change-me
