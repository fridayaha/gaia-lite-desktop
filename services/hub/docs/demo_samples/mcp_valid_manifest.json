{
  "name": "PostgreSQL Connector MCP",
  "type": "mcp",
  "version": "1.0.0",
  "manifest_version": "0.1",
  "description": "提供 PostgreSQL 数据库连接能力，支持查询和事务操作",
  "transport": "stdio",
  "mcp_server": {
    "command": "python",
    "args": ["-m", "postgres_mcp_server"],
    "env": {
      "DB_HOST": "localhost",
      "DB_PORT": "5432",
      "DB_NAME": "hub_demo"
    }
  },
  "permission_json": {
    "allowed_actions": ["database", "sql_execute"],
    "scope": ["internal_db"],
    "allowed_paths": ["/var/lib/postgresql/"],
    "access_mode": "read_write"
  },
  "runtime_compatibility": {
    "platform": "linux",
    "required_tools": ["python3", "libpq"],
    "min_runtime_version": "1.0.0"
  }
}
